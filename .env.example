# web-scraping-firecrawl-vpn configuration
# Copy to .env, fill the empty values, then run ./scripts/validate.sh
# Never commit .env. Use LF line endings (not CRLF).

# ---------------------------------------------------------------- ACCESS / NETWORK
# Host address the Firecrawl API binds to. Keep loopback: the API has no authentication.
API_BIND_ADDRESS=127.0.0.1
FIRECRAWL_PORT=3002
# Docker network shared with API consumers (they call http://gluetun:3002).
EDGE_NETWORK_NAME=firecrawl-edge
# Internal network for redis/rabbitmq/postgres (only subnet allowed outside the VPN).
# Change only if it collides with an existing network on the host.
BACKEND_SUBNET=172.30.0.0/24

# ---------------------------------------------------------------- VPN (Gluetun + Proton)
# PrivateKey from a WireGuard config generated at https://account.proton.me/u/0/vpn/WireGuard
WIREGUARD_PRIVATE_KEY=
# Exit country/city (Gluetun server list names), comma-separated.
SERVER_COUNTRIES=Netherlands
SERVER_CITIES=
# Key for Gluetun's control server (used by test scripts). Generate: openssl rand -hex 24
GLUETUN_CONTROL_API_KEY=

# ---------------------------------------------------------------- INTERNAL DATABASES
# URL-safe characters only [A-Za-z0-9._~-]. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# ---------------------------------------------------------------- FIRECRAWL
# Protects Firecrawl admin routes (optional but recommended).
BULL_AUTH_KEY=
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5
LOGGING_LEVEL=info
# Optional: enables LLM features (extract / json format).
OPENAI_API_KEY=

# ---------------------------------------------------------------- RESOURCES
API_CPUS=4
API_MEMORY=8G
PLAYWRIGHT_CPUS=2
PLAYWRIGHT_MEMORY=4G
TZ=UTC
